{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khoacat12345/adaptive-swarm-pipeline/schemas/tasks.schema.json",
  "title": "Spec Kit tasks.yaml bridge schema",
  "type": "object",
  "required": ["schema_version", "goal", "phases"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "goal": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string"},
    "source": {
      "type": "object",
      "properties": {
        "spec": {"type": "string"},
        "plan": {"type": "string"},
        "tasks": {"type": "string"}
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "properties": {
        "requests": {"type": "integer", "minimum": 1},
        "cost_usd": {"type": "number", "minimum": 0},
        "wall_seconds": {"type": "integer", "minimum": 1},
        "emergency_reserve_pct": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "required": ["requests", "cost_usd", "wall_seconds"]
    },
    "environment": {
      "type": "object",
      "properties": {
        "env_allow": {"type": "array", "items": {"type": "string"}},
        "network_for_verify": {"type": "boolean"},
        "seed_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "allowed_paths", "budget", "work_orders"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "title": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "forbidden_paths": {"type": "array", "items": {"type": "string"}},
          "allow_new_files": {"type": "boolean"},
          "budget": {
            "type": "object",
            "required": ["requests", "cost_usd", "wall_seconds"],
            "properties": {
              "requests": {"type": "integer", "minimum": 1},
              "cost_usd": {"type": "number", "minimum": 0},
              "wall_seconds": {"type": "integer", "minimum": 1}
            }
          },
          "work_orders": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["id", "objective", "acceptance_criteria", "verify_command", "target_files"],
              "properties": {
                "id": {"type": "string"},
                "title": {"type": "string"},
                "objective": {"type": "string", "minLength": 1},
                "boundaries": {"type": "string"},
                "input_context": {"type": "string"},
                "acceptance_criteria": {"type": "string", "minLength": 1},
                "verify_command": {"type": "string", "minLength": 1},
                "target_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "sandbox_files": {"type": "array", "items": {"type": "string"}},
                "level": {"type": "integer", "enum": [0, 1, 2, 3]},
                "max_rounds": {"type": "integer", "minimum": 1, "maximum": 4},
                "depends_on": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "rollback": {"type": "object"},
          "cleanup": {"type": "string"}
        }
      }
    }
  }
}
